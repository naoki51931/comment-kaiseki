  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.4"
  }
}
